{
  "name": "tflo-browser-events",
  "version": "0.3.0",
  "description": "Capture browser events, transform them into typed domain signals with tflo-cep (Rust/WASM), and ship them to GA4 / a first-party collector / any HTTP sink.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/tflo_cep_wasm_bg.wasm": "./dist/wasm/tflo_cep_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "docs/AGENTS-integrating.md",
    "docs/LLM_PROMPT.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:ts": "tsc -p tsconfig.json",
    "copy:wasm": "mkdir -p dist/wasm && cp src/wasm/tflo_cep_wasm.js src/wasm/tflo_cep_wasm.d.ts src/wasm/tflo_cep_wasm_bg.wasm src/wasm/tflo_cep_wasm_bg.wasm.d.ts dist/wasm/",
    "verify:pack": "node -e \"const fs=require('fs');for (const f of ['dist/index.js','dist/index.d.ts','dist/wasm/tflo_cep_wasm.js','dist/wasm/tflo_cep_wasm_bg.wasm']) if(!fs.existsSync(f)){console.error('missing '+f);process.exit(1)}\"",
    "prepublishOnly": "npm run verify:pack",
    "build": "npm run build:wasm && npm run build:ts && npm run copy:wasm",
    "clean": "rm -rf dist wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "analytics",
    "browser",
    "cep",
    "event-pattern-matching",
    "wasm",
    "rust",
    "tflo",
    "privacy",
    "first-party"
  ],
  "author": "Matt Cochran",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/matt-cochran/tflo-browser-events"
  },
  "bugs": {
    "url": "https://github.com/matt-cochran/tflo-browser-events/issues"
  },
  "homepage": "https://github.com/matt-cochran/tflo-browser-events#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
